# =============================================================================
# PartRadar — root .gitignore
# Sub-projects may add their own .gitignore for tool-specific output.
# =============================================================================

# --- Operating systems -------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~
.directory
.Trash-*

# --- IDEs & editors ----------------------------------------------------------
# JetBrains
.idea/
*.iml
*.ipr
*.iws
out/
# VS Code (share only recommended extensions)
.vscode/*
!.vscode/extensions.json
*.code-workspace
.history/
# Eclipse / STS / NetBeans
.project
.classpath
.settings/
.factorypath
.apt_generated/
.springBeans
.sts4-cache/
bin/
nbproject/private/
nbbuild/
dist/
nbdist/
.nb-gradle/
# Vim / Emacs
*.swp
*.swo
*#
.#*

# --- Java / Maven / Gradle ---------------------------------------------------
target/
!.mvn/wrapper/maven-wrapper.jar
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
*.class
hs_err_pid*
replay_pid*
HELP.md

# --- Node.js / Next.js -------------------------------------------------------
node_modules/
.next/
.turbo/
.vercel/
coverage/
playwright-report/
test-results/
blob-report/
*.tsbuildinfo
next-env.d.ts
.npm/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Environment & secrets ---------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
*.truststore
secrets/
*.secret.yaml
*.secret.yml

# --- Containers & Kubernetes -------------------------------------------------
compose.override.yaml
compose.override.yml
docker-compose.override.yml
kubeconfig
kubeconfig*
*.kubeconfig
.kube/
# Packaged Helm charts (Chart.lock is committed)
deploy/helm/**/charts/*.tgz

# --- Terraform ---------------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
*.tfplan
crash.log
crash.*.log
.terraform.lock.hcl.bak

# --- Logs, dumps & temp files ------------------------------------------------
logs/
*.log
*.pid
*.seed
*.dump
*.tmp
*.bak
tmp/
.cache/

# --- Local tooling (assistant & editor-agent files) --------------------------
AGENTS.md
**/AGENTS.md
CLAUDE.md
CLAUDE.local.md
**/CLAUDE.md
GEMINI.md
.claude/
.gemini/
.cursor/
.cursorrules
.cursorignore
.windsurf/
.windsurfrules
.aider*
.codex/
.continue/
.copilot/
.github/copilot-instructions.md
.mcp.json
.superpowers/

# --- Private documents (never commit) ----------------------------------------
*.pdf
